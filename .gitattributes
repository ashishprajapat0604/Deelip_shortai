# Windows scripts MUST keep CRLF endings — cmd.exe can mis-parse goto/labels in
# LF-only batch files, and this repo is developed on Linux where git would
# otherwise normalise them to LF on checkout.
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Shell scripts must stay LF even if someone checks out on Windows.
*.sh   text eol=lf

# Binary assets: never line-ending-convert, never diff as text.
*.ico  binary
*.png  binary
*.jpg  binary
*.ttf  binary
*.mp4  binary
